<%@ include file="../common/header.jspf" %><h1>Customer Form</h1><form method="post" action="${pageContext.request.contextPath}/customers/save" class="card p-4"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="id" value="${item.id}"><label>Name</label><input class="form-control mb-3" name="name" value="${item.name}" required><label>Email</label><textarea class="form-control mb-3" name="email">${item.email}</textarea><label>Phone</label><input class="form-control mb-3" name="phone" value="${item.phone}"><label>Address</label><textarea class="form-control mb-3" name="address">${item.address}</textarea><button class="btn btn-success">Save</button></form><%@ include file="../common/footer.jspf" %>