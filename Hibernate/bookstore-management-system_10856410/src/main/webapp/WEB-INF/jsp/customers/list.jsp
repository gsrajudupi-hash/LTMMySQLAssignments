<%@ include file="../common/header.jspf" %><div class="d-flex justify-content-between"><h1>Customers</h1><a class="btn btn-primary" href="customers/new">Add Customer</a></div><table class="table table-striped"><thead><tr><th>ID</th><th>Name</th><th>Email</th><th>Actions</th></tr></thead><tbody><c:forEach items="${items}" var="i"><tr><td>${i.id}</td><td>${i.name}</td><td>${i.email}</td><td><a class="btn btn-sm btn-warning" href="customers/edit/${i.id}">Edit</a><a class="btn btn-sm btn-info" href="customers/${i.id}/orders">Orders</a><sec:authorize access="hasRole('ADMIN')"><a class="btn btn-sm btn-danger" href="customers/delete/${i.id}">Delete</a></sec:authorize></td></tr></c:forEach></tbody></table><%@ include file="../common/footer.jspf" %>