<%@ include file="../common/header.jspf" %><div class="d-flex justify-content-between"><h1>Categorys</h1><a class="btn btn-primary" href="categories/new">Add Category</a></div><table class="table table-striped"><thead><tr><th>ID</th><th>Name</th><th>Description</th><th>Actions</th></tr></thead><tbody><c:forEach items="${items}" var="i"><tr><td>${i.id}</td><td>${i.name}</td><td>${i.description}</td><td><a class="btn btn-sm btn-warning" href="categories/edit/${i.id}">Edit</a><sec:authorize access="hasRole('ADMIN')"><a class="btn btn-sm btn-danger" href="categories/delete/${i.id}">Delete</a></sec:authorize></td></tr></c:forEach></tbody></table><%@ include file="../common/footer.jspf" %>