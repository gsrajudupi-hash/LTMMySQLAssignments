<%@ include file="../common/header.jspf" %><div class="d-flex justify-content-between"><h1>Books</h1><a class="btn btn-primary" href="books/new">Add Book</a></div><form class="my-3"><div class="input-group"><input class="form-control" name="q" value="${q}" placeholder="Search title or ISBN"><button class="btn btn-outline-primary">Search</button></div></form><div class="row g-3"><c:forEach items="${books}" var="b"><div class="col-md-4"><div class="card h-100"><img src="${b.imageUrl}" class="card-img-top book-cover" onerror="this.src='https://images.unsplash.com/photo-1544947950-fa07a98d237f?auto=format&fit=crop&w=600&q=80'"><div class="card-body"><h5>${b.title}</h5><p>${b.author.name} | ${b.category.name}</p><p>ISBN: ${b.isbn}<br>Price: ${b.price}<br>Stock: ${b.stockQuantity}</p><a class="btn btn-sm btn-warning" href="books/edit/${b.id}">Edit</a><sec:authorize access="hasRole('ADMIN')"><a class="btn btn-sm btn-danger" href="books/delete/${b.id}" onclick="return confirm('Delete?')">Delete</a></sec:authorize></div></div></div></c:forEach></div><%@ include file="../common/footer.jspf" %>