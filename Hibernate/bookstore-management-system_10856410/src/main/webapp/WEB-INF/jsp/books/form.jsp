<%@ include file="../common/header.jspf" %><h1>Book Form</h1><form method="post" action="${pageContext.request.contextPath}/books/save" class="card p-4"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="id" value="${book.id}"><label>Title</label><input class="form-control mb-2" name="title" value="${book.title}" required><label>ISBN</label><input class="form-control mb-2" name="isbn" value="${book.isbn}" required><label>Price</label><input class="form-control mb-2" type="number" step="0.01" min="0" name="price" value="${book.price}" required><label>Stock</label><input class="form-control mb-2" type="number" min="0" name="stockQuantity" value="${book.stockQuantity}" required><label>Online image URL</label><input class="form-control mb-2" name="imageUrl" value="${book.imageUrl}"><label>Author</label><select class="form-select mb-2" name="authorId"><c:forEach items="${authors}" var="a"><option value="${a.id}" ${book.author.id==a.id?'selected':''}>${a.name}</option></c:forEach></select><label>Category</label><select class="form-select mb-3" name="categoryId"><c:forEach items="${categories}" var="c"><option value="${c.id}" ${book.category.id==c.id?'selected':''}>${c.name}</option></c:forEach></select><button class="btn btn-success">Save</button></form><%@ include file="../common/footer.jspf" %>