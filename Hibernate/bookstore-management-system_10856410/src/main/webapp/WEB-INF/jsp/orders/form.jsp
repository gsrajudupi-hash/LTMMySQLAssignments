<%@ include file="../common/header.jspf" %><h1>Create Order</h1><form method="post" action="${pageContext.request.contextPath}/orders/create"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><label>Customer</label><select class="form-select mb-3" name="customerId"><c:forEach items="${customers}" var="c"><option value="${c.id}">${c.name}</option></c:forEach></select><table class="table"><tr><th>Book</th><th>Stock</th><th>Price</th><th>Quantity</th></tr><c:forEach items="${books}" var="b"><tr><td><input type="hidden" name="bookIds" value="${b.id}">${b.title}</td><td>${b.stockQuantity}</td><td>${b.price}</td><td><input class="form-control" type="number" min="0" max="${b.stockQuantity}" value="0" name="quantities"></td></tr></c:forEach></table><button class="btn btn-success">Place Order</button></form><%@ include file="../common/footer.jspf" %>