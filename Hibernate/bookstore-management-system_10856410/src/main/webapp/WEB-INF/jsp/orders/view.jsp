<%@ include file="../common/header.jspf" %><h1>Order #${order.id}</h1><p>Customer: ${order.customer.name}<br>Date: ${order.orderDate}<br>Total: ${order.total}</p><table class="table"><tr><th>Book</th><th>Qty</th><th>Unit Price</th><th>Subtotal</th></tr><c:forEach items="${order.items}" var="i"><tr><td>${i.book.title}</td><td>${i.quantity}</td><td>${i.unitPrice}</td><td>${i.subtotal}</td></tr></c:forEach></table><form method="post" action="${pageContext.request.contextPath}/orders/${order.id}/status"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><select name="status" class="form-select d-inline w-auto"><c:forEach items="${statuses}" var="s"><option ${order.status==s?'selected':''}>${s}</option></c:forEach></select><button class="btn btn-primary">Update Status</button></form><%@ include file="../common/footer.jspf" %>