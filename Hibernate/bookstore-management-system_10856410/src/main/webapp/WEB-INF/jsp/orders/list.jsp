<%@ include file="../common/header.jspf" %><div class="d-flex justify-content-between"><h1>Orders</h1><a class="btn btn-primary" href="orders/new">Create Order</a></div><table class="table"><tr><th>ID</th><th>Customer</th><th>Date</th><th>Status</th><th>Total</th></tr><c:forEach items="${orders}" var="o"><tr><td><a href="orders/${o.id}">${o.id}</a></td><td>${o.customer.name}</td><td>${o.orderDate}</td><td>${o.status}</td><td>${o.total}</td></tr></c:forEach></table><%@ include file="../common/footer.jspf" %>